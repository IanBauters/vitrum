<!doctype html>
<html lang="{{ site.taal }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.titel }}</title>
  <meta name="description" content="{{ samenvatting or site.intro }}">
  <meta property="og:title" content="{{ title or site.titel }}">
  <meta property="og:description" content="{{ samenvatting or site.intro }}">
  {% if afbeelding %}<meta property="og:image" content="{{ afbeelding | afbeeldingUrl }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%232F4BD8'/><text x='16' y='23' font-family='Arial' font-weight='900' font-size='20' text-anchor='middle' fill='white'>V</text></svg>">
</head>
<body>
  {{ content | safe }}
  <footer class="voet">
    <p>Verzameld door {{ site.auteur }}. Iets gezien dat hier thuishoort? Laat het me weten.</p>
  </footer>
</body>
</html>
